input type=\"checkbox\" id=\"incMonthly\"> Also include Ekadashi, Pournami, Amavasya and other monthly days</label>\n    <div class=\"actions\"><button class=\"primary\" type=\"button\" id=\"csvBtn\" hidden>Download all reminders to 2050 for Google Calendar</button>\n      <button class=\"btn\" type=\"button\" id=\"jsonBtn\" hidden>Download data for daily WhatsApp</button></div>\n    <div class=\"note\">\n      <p><b>Every reminder, every year, automatically:</b> download the file, then in Google Calendar on a computer go to Settings → Import and pick it. Each festival and family tithi appears on its day with the things to do, and Google reminds you on your phone. Set all-day notifications to \"1 day before\" in Google Calendar settings. Or tap <b>Remind me</b> on any single day.</p>\n      <p><b>WhatsApp:</b> the WhatsApp button opens WhatsApp with the message typed, and you choose who gets it. For an automatic message every morning, the daily WhatsApp job sends today's tithi, festivals and your notes. After you add or change family dates or notes, tap <b>Download data for daily WhatsApp</b> and upload the file to the job's <code>data</code> folder on GitHub.</p>\n      <p><b>How days are worked out:</b> sun and moon positions are calculated on this page, using the amanta Telugu calendar and Lahiri ayanamsa. A day's tithi is the one running at sunrise. Festivals follow their traditional time of day: midday for Sri Rama Navami and Vinayaka Chavithi, afternoon for Dasara, evening for Deepavali, midnight for Shivaratri and Krishnashtami. In a year with an adhika month, the regular month is used. Families and temples sometimes choose the neighbouring day, so check close calls with your panchangam.</p>\n    </div>\n  </section>\n</div>\n<div class=\"toast\" id=\"toast\" hidden></div>\n\n<script>\n// Telugu panchangam engine: tithi, amanta masa (with adhika), sunrise. No API needed.\nconst Panchang = (() => {\n  const RAD = Math.PI / 180;\n  const norm = x => ((x % 360) + 360) % 360;\n  const sin = d => Math.sin(d * RAD), cos = d => Math.cos(d * RAD);\n\n  // Julian day (UT) from JS Date\n  const jdFromDate = dt => dt.getTime() / 86400000 + 2440587.5;\n  const dateFromJd = jd => new Date((jd - 2440587.5) * 86400000);\n  const tOf = jdUT => (jdUT + 70 / 86400 - 2451545.0) / 36525; // ~ΔT 70s\n\n  function sunLon(jd) {\n    const T = tOf(jd);\n    const L0 = 280.46646 + 36000.76983 * T + 0.0003032 * T * T;\n    const M = 357.52911 + 35999.05029 * T - 0.0001537 * T * T;\n    const C = (1.914602 - 0.004817 * T - 0.000014 * T * T) * sin(M)\n      + (0.019993 - 0.000101 * T) * sin(2 * M) + 0.000289 * sin(3 * M);\n    const om = 125.04 - 1934.136 * T;\n    return norm(L0 + C - 0.00569 - 0.00478 * sin(om));\n  }\n\n  // Meeus ch.47 main periodic terms: D, M, M', F, coeff (1e-6 deg)\n  const MT = [\n    [0,0,1,0,6288774],[2,0,-1,0,1274027],[2,0,0,0,658314],[0,0,2,0,213618],[0,1,0,0,-185116],\n    [0,0,0,2,-114332],[2,0,-2,0,58793],[2,-1,-1,0,57066],[2,0,1,0,53322],[2,-1,0,0,45758],\n    [0,1,-1,0,-40923],[1,0,0,0,-34720],[0,1,1,0,-30383],[2,0,0,-2,15327],[0,0,1,2,-12528],\n    [0,0,1,-2,10980],[4,0,-1,0,10675],[0,0,3,0,10034],[4,0,-2,0,8548],[2,1,-1,0,-7888],\n    [2,1,0,0,-6766],[1,0,-1,0,-5163],[1,1,0,0,4987],[2,-1,1,0,4036],[2,0,2,0,3994],\n    [4,0,0,0,3861],[2,0,-3,0,3665],[0,1,-2,0,-2689],[2,0,-1,2,-2602],[2,-1,-2,0,2390],\n    [1,0,1,0,-2348],[2,-2,0,0,2236],[0,1,2,0,-2120],[0,2,0,0,-2069],[2,-2,-1,0,2048],\n    [2,0,1,-2,-1773],[2,0,0,2,-1595],[4,-1,-1,0,1215],[0,0,2,2,-1110],[3,0,-1,0,-892],\n    [2,1,1,0,-810],[4,-1,-2,0,759],[0,2,-1,0,-713],[2,2,-1,0,-700],[2,1,-2,0,691],\n    [2,-1,0,-2,596],[4,0,1,0,549],[0,0,4,0,537],[4,-1,0,0,520],[1,0,-2,0,-487],\n    [2,1,0,-2,-399],[0,0,2,-2,-381],[1,1,1,0,351],[3,0,-2,0,-340],[4,0,-3,0,330],\n    [2,-1,2,0,327],[0,2,1,0,-323],[1,1,-1,0,299],[2,0,3,0,294]\n  ];\n\n  function moonLon(jd) {\n    const T = tOf(jd), T2 = T * T, T3 = T2 * T, T4 = T3 * T;\n    const Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T2 + T3 / 538841 - T4 / 65194000;\n    const D = 297.8501921 + 445267.1114034 * T - 0.0018819 * T2 + T3 / 545868 - T4 / 113065000;\n    const M = 357.5291092 + 35999.0502909 * T - 0.0001536 * T2 + T3 / 24490000;\n    const Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T2 + T3 / 69699 - T4 / 14712000;\n    const F = 93.2720950 + 483202.0175233 * T - 0.0036539 * T2 - T3 / 3526000 + T4 / 863310000;\n    const E = 1 - 0.002516 * T - 0.0000074 * T2;\n    let s = 0;\n    for (const [d, m, mp, f, c] of MT) {\n      let k = c;\n      if (m === 1 || m === -1) k *= E; else if (m === 2 || m === -2) k *= E * E;\n      s += k * sin(d * D + m * M + mp * Mp + f * F);\n    }\n    const A1 = 119.75 + 131.849 * T, A2 = 53.09 + 479264.290 * T;\n    s += 3958 * sin(A1) + 1962 * sin(Lp - F) + 318 * sin(A2);\n    const om = 125.04 - 1934.136 * T;\n    return norm(Lp + s / 1e6 - 0.00478 * sin(om));\n  }\n\n  const elong = jd => norm(moonLon(jd) - sunLon(jd));\n  const ayanamsa = jd => 23.853 + ((jd - 2451545.0) / 365.25) * 0.0139689; // Lahiri, approx\n  const siderealSun = jd => norm(sunLon(jd) - ayanamsa(jd));\n\n  // Find time near jdGuess (within ~±15 days) when elongation equals target angle\n  function findElong(target, jdGuess) {\n    let jd = jdGuess;\n    for (let i = 0; i < 30; i++) {\n      let diff = norm(target - elong(jd));\n      if (diff > 180) diff -= 360;\n      if (Math.abs(diff) < 1e-6) break;\n      jd += diff / 12.19; // mean relative speed deg/day\n    }\n    return jd;\n  }\n\n  // New moon at or before jd\n  function prevNewMoon(jd) {\n    const e = elong(jd);\n    let nm = findElong(0, jd - e / 12.19);\n    if (nm > jd) nm = findElong(0, nm - 29.53);\n    return nm;\n  }\n\n  const MASAS = ['Chaitra','Vaishakha','Jyeshtha','Ashadha','Shravana','Bhadrapada',\n    'Ashvayuja','Kartika','Margashira','Pushya','Magha','Phalguna'];\n  const MASAS_TE = ['చైత్రము','వైశాఖము','జ్యేష్ఠము','ఆషాఢము','శ్రావణము','భాద్రపదము',\n    'ఆశ్వయుజము','కార్తీకము','మార్గశిరము','పుష్యము','మాఘము','ఫాల్గుణము'];\n  const TITHIS = ['Pratipada','Vidiya','Tadiya','Chavithi','Panchami','Shashthi','Saptami',\n    'Ashtami','Navami','Dashami','Ekadashi','Dvadashi','Trayodashi','Chaturdashi'];\n  const TITHIS_TE = ['పాడ్యమి','విదియ','తదియ','చవితి','పంచమి','షష్ఠి','సప్తమి','అష్టమి',\n    'నవమి','దశమి','ఏకాదశి','ద్వాదశి','త్రయోదశి','చతుర్దశి'];\n  function tithiName(t) { // t: 1..30\n    if (t === 15) return { en: 'Pournami', te: 'పౌర్ణమి' };\n    if (t === 30) return { en: 'Amavasya', te: 'అమావాస్య' };\n    const i = (t - 1) % 15;\n    return { en: TITHIS[i], te: TITHIS_TE[i] };\n  }\n\n  // Lunar month starting at new moon nm: name by sun's sidereal rashi at nm; adhika if next nm in same rashi\n  function monthInfo(nm) {\n    const r1 = Math.floor(siderealSun(nm) / 30);\n    const nm2 = findElong(0, nm + 29.53);\n    const r2 = Math.floor(siderealSun(nm2) / 30);\n    // rashi 11 (Meena) -> Chaitra(0), 0 (Mesha) -> Vaishakha(1), ...\n    return { masa: (r1 + 1) % 12, adhika: r1 === r2, start: nm, end: nm2 };\n  }\n\n  // Sunrise (UT JD) for local civil date y-m-d at lat/lon, tz hours\n  function sunriseJd(y, m, d, lat, lon, tz) {\n    const N = Math.floor((Date.UTC(y, m - 1, d) - Date.UTC(y, 0, 0)) / 86400000);\n    const lngHour = lon / 15;\n    const t = N + (6 - lngHour) / 24;\n    const M = 0.9856 * t - 3.289;\n    const L = norm(M + 1.916 * sin(M) + 0.020 * sin(2 * M) + 282.634);\n    let RA = norm(Math.atan(0.91764 * Math.tan(L * RAD)) / RAD);\n    RA += Math.floor(L / 90) * 90 - Math.floor(RA / 90) * 90;\n    RA /= 15;\n    const sinDec = 0.39782 * sin(L), cosDec = Math.cos(Math.asin(sinDec));\n    const cosH = (cos(90.833) - sinDec * sin(lat)) / (cosDec * cos(lat));\n    const H = (360 - Math.acos(Math.max(-1, Math.min(1, cosH))) / RAD) / 15;\n    const T = H + RA - 0.06571 * t - 6.622;\n    const UT = ((T - lngHour) % 24 + 24) % 24;\n    let jd = Date.UTC(y, m - 1, d) / 86400000 + 2440587.5 + UT / 24;\n    if (UT + tz >= 24) jd -= 1; else if (UT + tz < 0) jd += 1; // keep sunrise on the local date\n    return jd;\n  }\n\n  // Local civil date (y,m,d) of a UT JD for timezone tz\n  function localYMD(jd, tz) {\n    const dt = dateFromJd(jd + tz / 24);\n    return [dt.getUTCFullYear(), dt.getUTCMonth() + 1, dt.getUTCDate()];\n  }\n  const addDays = ([y, m, d], n) => {\n    const dt = new Date(Date.UTC(y, m - 1, d + n));\n    return [dt.getUTCFullYear(), dt.getUTCMonth() + 1, dt.getUTCDate()];\n  };\n\n  // Panchang for a civil date at sunrise\n  function dayInfo(y, m, d, loc) {\n    const sr = sunriseJd(y, m, d, loc.lat, loc.lon, loc.tz);\n    const tithi = Math.floor(elong(sr) / 12) + 1;\n    const mi = monthInfo(prevNewMoon(sr));\n    return { tithi, paksha: tithi <= 15 ? 'Shukla' : 'Krishna', masa: mi.masa, adhika: mi.adhika, sunrise: sr };\n  }\n\n  const jdOfYMD = ([y, m, d]) => Date.UTC(y, m - 1, d) / 86400000 + 2440587.5;\n\n  // Lunar months whose span touches [jdFrom, jdTo)\n  function lunarMonths(jdFrom, jdTo) {\n    const out = [];\n    let nm = prevNewMoon(jdFrom);\n    while (nm < jdTo) { const mi = monthInfo(nm); out.push(mi); nm = mi.end; }\n    return out;\n  }\n\n  // Civil day for a tithi in the month starting at new moon nm: the first day whose sunrise\n  // (+ kalaHours, e.g. 6 = midday, 18 = midnight) falls in it, else (kshaya) the day it begins\n  function tithiDay(nm, tithi, loc, kalaHours = 0) {\n    const tStart = tithi === 1 ? nm : findElong((tithi - 1) * 12, nm + (tithi - 0.5) * 0.984);\n    const tEnd = findElong((tithi * 12) % 360, nm + (tithi + 0.5) * 0.984);\n    let day = localYMD(tStart, loc.tz);\n    for (let i = 0; i < 3; i++) {\n      const sr = sunriseJd(day[0], day[1], day[2], loc.lat, loc.lon, loc.tz);\n      const k = sr + kalaHours / 24;\n      if (k >= tStart && k < tEnd) return { ymd: day, kshaya: false };\n      day = addDays(day, 1);\n    }\n    if (kalaHours) return tithiDay(nm, tithi, loc, 0); // not running at that hour on any day: fall back to sunrise\n    return { ymd: localYMD(tStart, loc.tz), kshaya: true };\n  }\n\n  // All civil dates in [fromYear, toYear] that fall on (masa, tithi), nija month only\n  function occurrences(masa, tithi, fromYear, toYear, loc) {\n    const months = lunarMonths(jdOfYMD([fromYear - 1, 11, 1]), jdOfYMD([toYear + 1, 2, 1]));\n    return months.filter(mi => mi.masa === masa && !mi.adhika)\n      .map(mi => tithiDay(mi.start, tithi, loc))\n      .filter(o => o.ymd[0] >= fromYear && o.ymd[0] <= toYear);\n  }\n\n  // Day of a solar sankranti (sun enters sidereal rashi r) near Gregorian year y;\n  // if it happens after ~sunset (18:00 local) the festival is the next day\n  function sankrantiDay(y, r, loc) {\n    const target = r * 30;\n    let jd = jdOfYMD([y, 1, 1]) + norm(target - siderealSun(jdOfYMD([y, 1, 1]))) / 0.9856;\n    for (let i = 0; i < 20; i++) {\n      let diff = norm(target - siderealSun(jd)); if (diff > 180) diff -= 360;\n      if (Math.abs(diff) < 1e-6) break; jd += diff / 0.9856;\n    }\n    const local = jd + loc.tz / 24, frac = local + 0.5 - Math.floor(local + 0.5);\n    const ymd = localYMD(jd, loc.tz);\n    return frac >= 0.75 ? addDays(ymd, 1) : ymd;\n  }\n\n  const SAMVATSARAS = ['Prabhava','Vibhava','Shukla','Pramoduta','Prajotpatti','Angirasa','Shrimukha','Bhava','Yuva','Dhatu',\n    'Ishvara','Bahudhanya','Pramadhi','Vikrama','Vrusha','Chitrabhanu','Svabhanu','Tarana','Parthiva','Vyaya',\n    'Sarvajit','Sarvadhari','Virodhi','Vikruti','Khara','Nandana','Vijaya','Jaya','Manmatha','Durmukhi',\n    'Hevilambi','Vilambi','Vikari','Sharvari','Plava','Shubhakrut','Shobhakrut','Krodhi','Vishvavasu','Parabhava',\n    'Plavanga','Kilaka','Saumya','Sadharana','Virodhikrut','Paridhavi','Pramadicha','Ananda','Rakshasa','Nala',\n    'Pingala','Kalayukti','Siddharthi','Raudri','Durmati','Dundubhi','Rudhirodgari','Raktakshi','Krodhana','Akshaya'];\n  const SAMVATSARAS_TE = ['ప్రభవ','విభవ','శుక్ల','ప్రమోదూత','ప్రజోత్పత్తి','ఆంగీరస','శ్రీముఖ','భావ','యువ','ధాత',\n    'ఈశ్వర','బహుధాన్య','ప్రమాది','విక్రమ','వృష','చిత్రభాను','స్వభాను','తారణ','పార్థివ','వ్యయ',\n    'సర్వజిత్','సర్వధారి','విరోధి','వికృతి','ఖర','నందన','విజయ','జయ','మన్మథ','దుర్ముఖి',\n    'హేవిళంబి','విళంబి','వికారి','శార్వరి','ప్లవ','శుభకృత్','శోభకృత్','క్రోధి','విశ్వావసు','పరాభవ',\n    'ప్లవంగ','కీలక','సౌమ్య','సాధారణ','విరోధికృత్','పరిధావి','ప్రమాదీచ','ఆనంద','రాక్షస','నల',\n    'పింగళ','కాళయుక్తి','సిద్ధార్థి','రౌద్రి','దుర్మతి','దుందుభి','రుధిరోద్గారి','రక్తాక్షి','క్రోధన','అక్షయ'];\n  // Telugu year (from Ugadi) for a civil date and its lunar month\n  function samvatsara(ymd, masa) {\n    const y = ymd[0] - (ymd[1] <= 4 && masa >= 9 ? 1 : 0);\n    const i = (((y - 1987) % 60) + 60) % 60; // 1987-88 was Prabhava\n    return { en: SAMVATSARAS[i], te: SAMVATSARAS_TE[i], startYear: y };\n  }\n\n  return { dayInfo, occurrences, lunarMonths, tithiDay, sankrantiDay, samvatsara, siderealSun, sunriseJd,\n    tithiName, MASAS, MASAS_TE, dateFromJd, localYMD, addDays, jdOfYMD };\n})();\n\n\n</script>\n<script>\n// Telugu festivals and monthly special days, with what to do on each\nconst Festivals = ((P) => {\n  // Hours after sunrise at which a festival's tithi must be running (traditional kala rules)\n  const MID = 6, APA = 8.5, PRA = 13, NIS = 18, ARU = -1.5;\n  // masa index: 0 Chaitra … 11 Phalguna; tithi 1–15 Shukla, 16–30 Krishna (30 = Amavasya)\n  const LIST = [\n    { id: 'ugadi', te: 'ఉగాది', en: 'Ugadi (Telugu New Year)', masa: 0, tithi: 1, major: true,\n      todo: ['Oil bath (abhyanga snanam) early in the morning', 'Mango-leaf toranam on the door and muggulu in front of the house',\n        'Make Ugadi pachadi with the six tastes: neem flower, jaggery, tamarind, raw mango, salt and chilli',\n        'Listen to Panchanga Shravanam for the new year', 'New clothes and a temple visit'] },\n    { id: 'ramanavami', te: 'శ్రీరామ నవమి', en: 'Sri Rama Navami', masa: 0, tithi: 9, major: true, kala: MID,\n      todo: ['Sita Rama Kalyanam puja at home or at the temple', 'Offer panakam and vadapappu as prasadam', 'Read or listen to the Ramayana'] },\n    { id: 'akshaya', te: 'అక్షయ తృతీయ', en: 'Akshaya Tritiya', masa: 1, tithi: 3,\n      todo: ['Lakshmi puja', 'Give water, buttermilk or food in charity (danam)', 'A good day to buy gold or start something new'] },\n    { id: 'hanuman', te: 'హనుమజ్జయంతి', en: 'Hanuman Jayanti', masa: 1, tithi: 25, major: true,\n      todo: ['Recite Hanuman Chalisa or Sundarakanda', 'Visit a Hanuman temple', 'Offer a tamalapaku (betel leaf) garland'] },\n    { id: 'tholiekadashi', te: 'తొలి ఏకాదశి', en: 'Tholi Ekadashi', masa: 3, tithi: 11, major: true,\n      todo: ['Fast (upavasam) and do Vishnu puja', 'Offer pelala pindi (roasted flour with jaggery) as prasadam', 'Chaturmasya begins today'] },\n    { id: 'gurupournami', te: 'గురు పౌర్ణమి', en: 'Guru Pournami', masa: 3, tithi: 15,\n      todo: ['Honour your guru and teachers', 'Vyasa puja', 'Visit a Sai Baba or Dattatreya temple'] },\n    { id: 'nagapanchami', te: 'నాగ పంచమి', en: 'Naga Panchami', masa: 4, tithi: 5,\n      todo: ['Offer milk at a snake anthill (putta)', 'Naga devata puja'] },\n    { id: 'varalakshmi', te: 'వరలక్ష్మీ వ్రతం', en: 'Varalakshmi Vratam', special: 'varalakshmi', major: true,\n      todo: ['Women do Varalakshmi puja with a decorated kalasham', 'Tie the sacred thoram on the wrist',\n        'Invite women home for thamboolam (betel leaves, turmeric, kumkum)'] },\n    { id: 'rakhi', te: 'రాఖీ పౌర్ణమి · జంధ్యాల పౌర్ణమి', en: 'Raksha Bandhan · Jandhyala Pournami', masa: 4, tithi: 15, major: true,\n      todo: ['Sisters tie rakhi to brothers', 'Men who wear the sacred thread change their jandhyam'] },\n    { id: 'krishnashtami', te: 'శ్రీకృష్ణాష్టమి', en: 'Sri Krishna Janmashtami', masa: 4, tithi: 23, major: true, kala: NIS,\n      todo: ['Fast until midnight, when Krishna was born', 'Draw little feet from the door to the puja room',\n        'Offer butter, atukulu (poha) and milk sweets', 'Utti kottadam (breaking the pot) with the children'] },\n    { id: 'vinayaka', te: 'వినాయక చవితి', en: 'Vinayaka Chavithi', masa: 5, tithi: 4, major: true, kala: MID,\n      todo: ['Bring home a clay Ganesha', 'Patri puja with 21 kinds of leaves', 'Offer undrallu and kudumulu',\n        'Read the Vinayaka Chavithi katha and put the akshintalu on your head', 'Avoid looking at the moon tonight'] },\n    { id: 'mahalaya', te: 'మహాలయ అమావాస్య · ఎంగిలి పూల బతుకమ్మ', en: 'Mahalaya Amavasya · Engili Pula Bathukamma', masa: 5, tithi: 30, major: true,\n      todo: ['Tarpanam for ancestors (end of Pitru Paksham)', 'Bathukamma begins: arrange flowers in tiers',\n        'Women sing and dance around the Bathukamma in the evening'] },\n    { id: 'durgashtami', te: 'దుర్గాష్టమి · సద్దుల బతుకమ్మ', en: 'Durgashtami · Saddula Bathukamma', masa: 6, tithi: 8, major: true,\n      todo: ['Durga puja', 'Saddula Bathukamma: the biggest Bathukamma, then immersion in water', 'Share saddulu (flavoured rice dishes)'] },\n    { id: 'mahanavami', te: 'మహార్నవమి', en: 'Maha Navami', masa: 6, tithi: 9,\n      todo: ['Ayudha puja: worship tools, vehicles and books', 'Durga or Saraswati puja'] },\n    { id: 'dasara', te: 'విజయదశమి (దసరా)', en: 'Vijayadashami (Dasara)', masa: 6, tithi: 10, major: true, kala: APA,\n      todo: ['Jammi (Shami) puja and give jammi leaves to elders for blessings', 'Try to see a palapitta (Indian roller) bird',\n        'A good day to start learning (aksharabhyasam)', 'Ravana dahanam in the evening'] },\n    { id: 'atlataddi', te: 'అట్లతద్ది', en: 'Atla Taddi', masa: 6, tithi: 18,\n      todo: ['Women and girls eat before dawn, then fast', 'Make attlu (dosas) and offer them to Gauri', 'Swings and games with friends'] },\n    { id: 'narakachaturdashi', te: 'నరక చతుర్దశి', en: 'Naraka Chaturdashi', masa: 6, tithi: 29, major: true, kala: ARU,\n      todo: ['Oil bath before sunrise', 'Light diyas in the evening', 'Crackers with the family'] },\n    { id: 'deepavali', te: 'దీపావళి', en: 'Deepavali', masa: 6, tithi: 30, major: true, kala: PRA,\n      todo: ['Lakshmi puja in the evening', 'Light diyas around the house', 'Share sweets with neighbours'] },\n    { id: 'nagulachavithi', te: 'నాగుల చవితి', en: 'Nagula Chavithi', masa: 7, tithi: 4, major: true,\n      todo: ['Fast and offer milk at a snake anthill (putta)', 'Offer chalimidi and nuvvula undalu (sesame balls)'] },\n    { id: 'kartikapournami', te: 'కార్తీక పౌర్ణమి', en: 'Kartika Pournami', masa: 7, tithi: 15, major: true,\n      todo: ['Light 365 wicks (deepam) at home or in a temple', 'Shiva puja', 'Float diyas in a river or pond (deepa danam)'] },\n    { id: 'subrahmanya', te: 'సుబ్రహ్మణ్య షష్ఠి', en: 'Subrahmanya Shashthi', masa: 8, tithi: 6,\n      todo: ['Subrahmanya Swamy puja and fasting', 'Visit a Subrahmanya temple'] },\n    { id: 'datta', te: 'దత్త జయంతి', en: 'Datta Jayanti', masa: 8, tithi: 15,\n      todo: ['Dattatreya puja', 'Read the Guru Charitra'] },\n    { id: 'mukkoti', te: 'ముక్కోటి ఏకాదశి', en: 'Mukkoti (Vaikuntha) Ekadashi', special: 'mukkoti', major: true,\n      todo: ['Uttara dwara darshanam (enter a Vishnu temple through the north gate)', 'Fast through the day', 'Stay up at night (jagaranam)'] },\n    { id: 'bhogi', te: 'భోగి', en: 'Bhogi', special: 'sankranti', offset: -1, major: true,\n      todo: ['Bhogi mantalu: a bonfire at dawn with old things', 'Bhogi pallu: shower regi pallu over the children in the evening',\n        'Big muggulu in front of the house'] },\n    { id: 'sankranti', te: 'మకర సంక్రాంతి', en: 'Makara Sankranti', special: 'sankranti', offset: 0, major: true,\n      todo: ['Muggulu with gobbemmalu (cow-dung balls with flowers)', 'Make pongali, ariselu and other pindi vantalu',\n        'Offerings for ancestors', 'Kite flying', 'Welcome the Haridasu and the Gangireddulu'] },\n    { id: 'kanuma', te: 'కనుమ', en: 'Kanuma', special: 'sankranti', offset: 1, major: true,\n      todo: ['Bathe and decorate the cattle, then do their puja', 'Family feast', 'Elders say not to travel today'] },\n    { id: 'vasantapanchami', te: 'వసంత పంచమి', en: 'Vasantha Panchami', masa: 10, tithi: 5,\n      todo: ['Saraswati puja', 'Aksharabhyasam for small children'] },\n    { id: 'rathasaptami', te: 'రథ సప్తమి', en: 'Ratha Saptami', masa: 10, tithi: 7, major: true,\n      todo: ['Bathe with seven jilledu (calotropis) leaves on the head', 'Surya puja at sunrise', 'Cook paramannam for Surya'] },\n    { id: 'shivaratri', te: 'మహా శివరాత్రి', en: 'Maha Shivaratri', masa: 10, tithi: 29, major: true, kala: NIS,\n      todo: ['Fast through the day', 'Abhishekam to Shiva with milk and water', 'Stay awake through the night (jagaranam)', 'Visit a Shiva temple'] },\n    { id: 'holi', te: 'హోళీ · కాముని పౌర్ణమి', en: 'Holi · Kamuni Pournami', masa: 11, tithi: 15, major: true, kala: PRA,\n      todo: ['Kama dahanam bonfire tonight', 'Colours are played the next morning', 'Sweets with friends and family'] },\n  ];\n\n  // Monthly special days (any month)\n  const RECURRING = [\n    { id: 'ekadashi', te: 'ఏకాదశి', en: 'Ekadashi', tithis: [11, 26],\n      todo: ['Fast or eat light food; skip rice', 'Vishnu puja or Vishnu Sahasranamam'] },\n    { id: 'pournami', te: 'పౌర్ణమి', en: 'Pournami (full moon)', tithis: [15],\n      todo: ['Satyanarayana Swamy vratam if your family does it', 'Light a lamp in the evening', 'Temple visit'] },\n    { id: 'amavasya', te: 'అమావాస్య', en: 'Amavasya (new moon)', tithis: [30],\n      todo: ['Tarpanam for ancestors', 'Light a lamp in the evening', 'Elders avoid starting new work today'] },\n    { id: 'sankashti', te: 'సంకష్టహర చతుర్థి', en: 'Sankashti Chaturthi', tithis: [19],\n      todo: ['Ganesha puja', 'Fast until moonrise, then eat after seeing the moon'] },\n    { id: 'pradosham', te: 'ప్రదోషం', en: 'Pradosham', tithis: [13, 28],\n      todo: ['Shiva puja at dusk (pradosha kalam)', 'Temple visit in the evening'] },\n    { id: 'masashivaratri', te: 'మాస శివరాత్రి', en: 'Masa Shivaratri', tithis: [29],\n      todo: ['Shiva abhishekam', 'Fast through the day if you can'] },\n  ];\n  const KARTIKA_MONDAY = { id: 'kartikasomavaram', te: 'కార్తీక సోమవారం', en: 'Kartika Somavaram',\n    todo: ['Fast until evening', 'Shiva abhishekam and a lamp at dusk'] };\n\n  const key = ymd => ymd.join('-');\n  const weekday = ([y, m, d]) => new Date(Date.UTC(y, m - 1, d)).getUTCDay();\n\n  // All festivals and special days with fromYMD <= day <= toYMD, sorted\n  function between(fromYMD, toYMD, loc) {\n    const a = P.jdOfYMD(fromYMD), b = P.jdOfYMD(toYMD) + 1;\n    const out = [], seen = new Set();\n    const push = (f, o, masa) => {\n      const j = P.jdOfYMD(o.ymd); if (j < a || j >= b) return;\n      if (seen.has(f.id + key(o.ymd))) return; seen.add(f.id + key(o.ymd));\n      out.push({ f, ymd: o.ymd, kshaya: !!o.kshaya, masa });\n    };\n    const months = P.lunarMonths(a - 32, b + 32);\n    for (const mi of months) {\n      for (const r of RECURRING) for (const t of r.tithis) {\n        if (r.id === 'masashivaratri' && mi.masa === 10 && !mi.adhika) continue; // Maha Shivaratri that month\n        push(r, P.tithiDay(mi.start, t, loc), mi.masa);\n      }\n      if (mi.adhika) continue;\n      for (const f of LIST) if (f.masa === mi.masa) push(f, P.tithiDay(mi.start, f.tithi, loc, f.kala || 0), mi.masa);\n      if (mi.masa === 4) { // Varalakshmi: the Friday on or before Shravana Pournami\n        const pn = P.tithiDay(mi.start, 15, loc).ymd;\n        push(LIST.find(f => f.id === 'varalakshmi'), { ymd: P.addDays(pn, -((weekday(pn) - 5 + 7) % 7)) }, 4);\n      }\n      if (mi.masa === 8 || mi.masa === 9) { // Mukkoti: Shukla Ekadashi while the sun is in Dhanu\n        const o = P.tithiDay(mi.start, 11, loc), sr = P.sunriseJd(...o.ymd, loc.lat, loc.lon, loc.tz);\n        const s = P.siderealSun(sr);\n        if (s >= 240 && s < 270) push(LIST.find(f => f.id === 'mukkoti'), o, mi.masa);\n      }\n      if (mi.masa === 7) { // Mondays of Kartika\n        let d = P.localYMD(mi.start, loc.tz);\n        for (let i = 0; i < 32; i++, d = P.addDays(d, 1)) {\n          const sr = P.sunriseJd(...d, loc.lat, loc.lon, loc.tz);\n          if (sr < mi.start) continue;\n          if (sr >= mi.end) break;\n          if (weekday(d) === 1) push(KARTIKA_MONDAY, { ymd: d }, 7);\n        }\n      }\n    }\n    for (let y = fromYMD[0]; y <= toYMD[0] + 1; y++) {\n      const s = P.sankrantiDay(y, 9, loc);\n      for (const f of LIST.filter(f => f.special === 'sankranti')) push(f, { ymd: P.addDays(s, f.offset) }, 9);\n    }\n    return out.sort((x, y) => P.jdOfYMD(x.ymd) - P.jdOfYMD(y.ymd) || (y.f.major ? 1 : 0) - (x.f.major ? 1 : 0));\n  }\n\n  return { LIST, RECURRING, between };\n})(Panchang);\n\n\n</script>\n<script>\n// Saves to the Google Sheet through Apps Script; refreshes every 20 s and when the page comes back into view\nconst GASDB = (() => {\n  const call = (fn, ...a) => new Promise((res, rej) => google.script.run.withSuccessHandler(res)\n    .withFailureHandler(e => rej({ code: 'unavailable', message: (e && e.message) || String(e) }))[fn](...a));\n  const subs = {};\n  async function refresh(coll) {\n    const list = subs[coll]; if (!list) return;\n    try {\n      const rows = await call('listDocs', coll);\n      const snap = { docs: rows.map(r => ({ id: r.id, exists: true, data: () => r.data })) };\n      list.forEach(([next]) => next(snap));\n    } catch (e) { list.forEach(([, err]) => err && err(e)); }\n  }\n  setInterval(() => Object.keys(subs).forEach(refresh), 20000);\n  document.addEventListener('visibilitychange', () => { if (!document.hidden) Object.keys(subs).forEach(refresh); });\n  return { collection: coll => ({\n    onSnapshot(next, err) { (subs[coll] = subs[coll] || []).push([next, err]); refresh(coll); return () => {}; },\n    doc: id => ({\n      set: async body => { await call('setDoc', coll, id, body, false); refresh(coll); },\n      update: async body => { await call('setDoc', coll, id, body, true); refresh(coll); },\n      delete: async () => { await call('deleteDoc', coll, id); refresh(coll); },\n    }),\n  }) };\n})();\nwindow.claude = { use: async name => (name === 'db' ? GASDB : null) };\n</script>\n<script>\n(() => {\nconst P = Panchang, F = Festivals;\nconst END_YEAR = 2050;\nconst CITIES = {\n  hyd: { name: 'Hyderabad', lat: 17.385, lon: 78.4867, tz: 5.5 },\n  vij: { name: 'Vijayawada', lat: 16.5062, lon: 80.648, tz: 5.5 },\n  vsk: { name: 'Visakhapatnam', lat: 17.6868, lon: 83.2185, tz: 5.5 },\n  wgl: { name: 'Warangal', lat: 17.9689, lon: 79.5941, tz: 5.5 },\n  tpt: { name: 'Tirupati', lat: 13.6288, lon: 79.4192, tz: 5.5 },\n  blr: { name: 'Bengaluru', lat: 12.9716, lon: 77.5946, tz: 5.5 },\n  chn: { name: 'Chennai', lat: 13.0827, lon: 80.2707, tz: 5.5 },\n};\nconst OCC = { 'Birthday': 'పుట్టినరోజు', 'Wedding anniversary': 'పెళ్లిరోజు', 'Aabdikam': 'ఆబ్దికం', 'Other': 'ఇతర' };\nconst OCC_TODO = {\n  'Birthday': ['Oil bath and new clothes', 'Temple visit or archana in their name', 'Blessings from elders'],\n  'Wedding anniversary': ['Temple visit together', 'Blessings from elders'],\n  'Aabdikam': ['Shraddham with the family purohit', 'Pinda pradanam and tarpanam', 'Feed Brahmins or give food in charity'],\n  'Other': [],\n};\nconst VAARAM = ['ఆదివారం', 'సోమవారం', 'మంగళవారం', 'బుధవారం', 'గురువారం', 'శుక్రవారం', 'శనివారం'];\nconst VAARAM_EN = ['Aadivaaram', 'Somavaaram', 'Mangalavaaram', 'Budhavaaram', 'Guruvaaram', 'Shukravaaram', 'Shanivaaram'];\nconst $ = id => document.getElementById(id);\nconst esc = s => String(s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst pad = n => String(n).padStart(2, '0');\nconst dayNum = ([y, m, d]) => Date.UTC(y, m - 1, d) / 86400000;\nconst wd = ([y, m, d]) => new Date(Date.UTC(y, m - 1, d)).getUTCDay();\nconst todayYMD = () => { const d = new Date(); return [d.getFullYear(), d.getMonth() + 1, d.getDate()]; };\nconst keyOf = ymd => ymd.join('-');\n\nlet cityKey = 'hyd';\ntry { const c = localStorage.getItem('tithi-city'); if (c && CITIES[c]) cityKey = c; } catch {}\nconst loc = () => CITIES[cityKey];\n\nfunction tithiLabel(masa, tithi, adhika) {\n  const t = P.tithiName(tithi), full = tithi === 15 || tithi === 30;\n  const pk = tithi <= 15 ? ['శుక్ల', 'Shukla'] : ['బహుళ', 'Bahula'];\n  return {\n    te: `${adhika ? 'అధిక ' : ''}${P.MASAS_TE[masa]} ${full ? '' : pk[0] + ' '}${t.te}`,\n    en: `${adhika ? 'Adhika ' : ''}${P.MASAS[masa]} ${full ? '' : pk[1] + ' '}${t.en}`,\n  };\n}\nfunction whenLabel(ymd) {\n  const n = dayNum(ymd) - dayNum(todayYMD());\n  if (n === 0) return { te: 'ఈరోజు', en: 'Today', n };\n  if (n === 1) return { te: 'రేపు', en: 'Tomorrow', n };\n  return { te: `${n} రోజుల్లో`, en: `in ${n} days`, n };\n}\nfunction moonSvg(tithi, size) {\n  const c = size / 2, r = size / 2 - 1, a = (tithi - 0.5) * 12 * Math.PI / 180, k = Math.cos(a);\n  const waxing = tithi <= 15, rx = Math.abs(k) * r;\n  const outer = waxing ? 1 : 0, term = k > 0 ? (waxing ? 0 : 1) : (waxing ? 1 : 0);\n  return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 ${size} ${size}\" aria-hidden=\"true\">\n    <circle cx=\"${c}\" cy=\"${c}\" r=\"${r}\" fill=\"var(--moondark)\"/>\n    <path d=\"M${c},${c - r} A${r},${r} 0 0 ${outer} ${c},${c + r} A${rx},${r} 0 0 ${term} ${c},${c - r}Z\" fill=\"var(--moonlit)\"/></svg>`;\n}\n\n// Reminder links (Google Calendar handles the actual date)\nfunction gcalUrl(title, details, ymd) {\n  const e = P.addDays(ymd, 1);\n  const p = new URLSearchParams({ action: 'TEMPLATE', text: title, dates: `${ymd[0]}${pad(ymd[1])}${pad(ymd[2])}/${e[0]}${pad(e[1])}${pad(e[2])}`, details });\n  return 'https:\\/\\/calendar.google.com/calendar/render?' + p.toString();\n}\nconst waUrl = text => 'https:\\/\\/wa.me/?text=' + encodeURIComponent(text);\nconst allTodo = it => [...it.todo, ...(it.mine || []).map(n => n.text)];\nfunction itemText(it) {\n  const lab = tithiLabel(it.masa, it.tithi, false), sv = P.samvatsara(it.ymd, it.masa), todo = allTodo(it);\n  return { title: it.title, details: `${sv.te} నామ సంవత్సరం · ${lab.te} · ${VAARAM[wd(it.ymd)]}\\n${todo.length ? 'Things to do:\\n• ' + todo.join('\\n• ') : ''}` };\n}\nfunction todoList(it) {\n  const mine = it.mine || [];\n  if (!it.todo.length && !mine.length) return '';\n  return `<ul>${it.todo.map(x => `<li>${esc(x)}</li>`).join('')}${mine.map(n => noteLi(n, n.repeat || 'mine')).join('')}</ul>`;\n}\nlet editingNote = null;\nfunction noteLi(n, tag) {\n  if (editingNote === n.id) return `<li class=\"mine\"><div class=\"addnote\"><input type=\"text\" value=\"${esc(n.text)}\" aria-label=\"Edit note\" maxlength=\"300\">\n    <button class=\"btn\" type=\"button\" data-save-note=\"${esc(n.id)}\">Save</button><button class=\"btn\" type=\"button\" data-cancel-note=\"1\">Cancel</button></div></li>`;\n  return `<li class=\"mine\">${esc(n.text)}${tag ? `<span class=\"mine-tag\">${esc(tag)}</span>` : ''}<button class=\"x\" type=\"button\" data-edit-note=\"${esc(n.id)}\" aria-label=\"Edit note\" title=\"Edit\">✎</button><button class=\"x\" type=\"button\" data-del-note=\"${esc(n.id)}\" aria-label=\"Remove note\" title=\"Remove\">×</button></li>`;\n}\nconst repeats = f => f.tithis || f.id === 'kartikasomavaram'; // monthly / weekly special days\n// target: a fixed target, or 'day' to choose what the note follows: a festival or family date on\n// that day (so it moves with it every year), the day's Telugu date, or its tithi every month\nfunction addBox(target, info, items = []) {\n  const opts = items.filter(it => it.f || it.fam).map(it => it.f\n    ? `<option value=\"fest:${esc(it.f.id)}\">${repeats(it.f) ? 'every' : 'every year on'} ${esc(it.f.te)}</option>`\n    : `<option value=\"fam:${esc(it.evId)}\">every year on ${esc(it.title)}</option>`).join('');\n  const sel = target === 'day' ? `<select aria-label=\"Repeat\">${opts}\n      <option value=\"year:${info.masa}:${info.tithi}\">every year on ${esc(tithiLabel(info.masa, info.tithi, false).te)}</option>\n      <option value=\"month:${info.tithi}\">every month on ${esc(P.tithiName(info.tithi).te)}</option></select>` : '';\n  return `<div class=\"addnote\" data-target=\"${esc(target)}\"><input type=\"text\" placeholder=\"Add my own thing to do…\" aria-label=\"My note\" maxlength=\"300\">${sel}<button class=\"btn\" type=\"button\" data-add-note=\"1\">Add</button></div>`;\n}\nfunction reminderButtons(it) {\n  const t = itemText(it), w = whenLabel(it.ymd);\n  const todo = allTodo(it);\n  const msg = `${it.title} – ${w.en === 'Today' ? 'today' : w.en === 'Tomorrow' ? 'tomorrow' : w.en} (${VAARAM[wd(it.ymd)]}, ${tithiLabel(it.masa, it.tithi, false).te}).${todo.length ? '\\n• ' + todo.join('\\n• ') : ''}`;\n  return `<a class=\"btn\" href=\"${gcalUrl(t.title, t.details, it.ymd)}\" target=\"_blank\" rel=\"noopener\">Remind me</a><a class=\"btn\" href=\"${waUrl(msg)}\" target=\"_blank\" rel=\"noopener\">WhatsApp</a>`;\n}\n\n// Family storage: shared db when available, else this browser\nlet events = [], store = 'local', db = null;\nconst LS = 'tithi-reminders-v2';\nconst loadLocal = () => { try { return JSON.parse(localStorage.getItem(LS) || '[]'); } catch { return []; } };\nconst saveLocal = () => { try { localStorage.setItem(LS, JSON.stringify(events)); } catch {} };\nevents = loadLocal();\n// My notes: { target: 'fest:<id>' | 'year:<masa>:<tithi>' | 'month:<tithi>', text }\nlet notes = [];\nconst NLS = 'tithi-notes-v1';\nconst loadNotes = () => { try { return JSON.parse(localStorage.getItem(NLS) || '[]'); } catch { return []; } };\nconst saveNotes = () => { try { localStorage.setItem(NLS, JSON.stringify(notes)); } catch {} };\nnotes = loadNotes();\nconst notesFor = (target, repeat) => notes.filter(n => n.target === target).map(n => ({ ...n, repeat }));\nconst EXAMPLE = { id: 'example', name: 'Example: Amma', occasion: 'Birthday', masa: 7, tithi: 5, example: true };\n\n// Occurrence caches\nconst famCache = new Map();\nfunction famDates(ev) {\n  const k = `${ev.masa}|${ev.tithi}|${cityKey}`;\n  if (!famCache.has(k)) famCache.set(k, P.occurrences(ev.masa, ev.tithi, todayYMD()[0], END_YEAR, loc()));\n  const t = dayNum(todayYMD());\n  return famCache.get(k).filter(o => dayNum(o.ymd) >= t);\n}\nconst famItem = (ev, o) => ({ ymd: o.ymd, masa: ev.masa, tithi: ev.tithi, title: `${ev.name} – ${OCC[ev.occasion] || ''} ${ev.occasion}`.trim(), todo: OCC_TODO[ev.occasion] || [], evId: ev.id, mine: ev.example ? [] : notesFor('fam:' + ev.id, 'every year') });\nfunction festItem(o) {\n  const info = o.f.tithi ? null : P.dayInfo(...o.ymd, loc()); // solar, weekday and monthly days: use that day's tithi\n  return { ymd: o.ymd, masa: info ? info.masa : o.masa, tithi: info ? info.tithi : o.f.tithi, title: `${o.f.te} · ${o.f.en}`, todo: o.f.todo, f: o.f, mine: notesFor('fest:' + o.f.id, repeats(o.f) ? 'every time' : 'every year') };\n}\n\nlet festYear = [];\nfunction computeFest() {\n  const t = todayYMD();\n  festYear = F.between(t, P.addDays(t, 366), loc());\n}\n\n// Today\nfunction renderToday() {\n  const t = todayYMD(), info = P.dayInfo(...t, loc()), lab = tithiLabel(info.masa, info.tithi, info.adhika), sv = P.samvatsara(t, info.masa);\n  $('todayCity').textContent = loc().name;\n  $('todayMoon').innerHTML = moonSvg(info.tithi, 56);\n  $('todayTe').textContent = `${lab.te} · ${VAARAM[wd(t)]}`;\n  $('todayEn').textContent = `శ్రీ ${sv.te} నామ సంవత్సరం · ${lab.en} · ${VAARAM_EN[wd(t)]} · ${sv.en} year`;\n  const items = itemsOn(t);\n  $('todayFest').hidden = !items.length;\n  $('todayFest').innerHTML = items.map(it => `<div><h3>${esc(it.title)}</h3>${todoList(it)}</div>`).join('');\n}\n\nfunction itemsOn(ymd) {\n  const k = keyOf(ymd);\n  const fest = festYear.filter(o => keyOf(o.ymd) === k).map(festItem);\n  const fam = (events.length ? events : []).flatMap(ev => famDates(ev).filter(o => keyOf(o.ymd) === k).map(o => ({ ...famItem(ev, o), fam: true })));\n  const info = P.dayInfo(...ymd, loc());\n  const mine = info.adhika ? notesFor('month:' + info.tithi, 'every month')\n    : [...notesFor(`year:${info.masa}:${info.tithi}`, 'every year'), ...notesFor('month:' + info.tithi, 'every month')];\n  const day = mine.length ? [{ ymd, masa: info.masa, tithi: info.tithi, title: 'నా గుర్తులు · My notes', todo: [], mine, minebox: true }] : [];\n  return [...fam, ...fest, ...day];\n}\n\n// Next 30 days\nfunction renderDays() {\n  const t = todayYMD(); let html = '';\n  for (let i = 0; i < 30; i++) {\n    const d = P.addDays(t, i), info = P.dayInfo(...d, loc()), lab = tithiLabel(info.masa, info.tithi, info.adhika), w = whenLabel(d);\n    const items = itemsOn(d);\n    const chips = items.map(it => `<span class=\"chip${it.fam ? ' fam' : it.f && it.f.major ? ' major' : ''}\">${esc(it.fam ? it.title : it.minebox ? 'నా గుర్తులు' : it.f.te)}</span>`).join('');\n    const top = `${moonSvg(info.tithi, 22)}<div class=\"when\">${w.te} · ${w.en}<span class=\"vaar\">${VAARAM[wd(d)]}</span></div>\n      <div class=\"what\"><span class=\"t\">${esc(lab.te)}</span>${chips}</div>`;\n    const k = 'day-' + keyOf(d);\n    html += `<details class=\"day${i === 0 ? ' today-row' : ''}\" data-key=\"${k}\"${openKeys.has(k) ? ' open' : ''}><summary>${top}</summary><div class=\"dbody\">${items.map(it => `<div>\n      <h4>${esc(it.title)}</h4>${todoList(it)}<div class=\"actions\">${reminderButtons(it)}</div></div>`).join('')}\n      <div><h4>నా గుర్తులు · Add my own note</h4>${addBox('day', info, items)}</div></div></details>`;\n  }\n  $('days').innerHTML = html;\n}\n\n// Festivals in the coming year (major ones)\nfunction renderFests() {\n  $('fests').innerHTML = festYear.filter(o => o.f.major).map(o => {\n    const it = festItem(o), tl = tithiLabel(it.masa, it.tithi, false), w = whenLabel(o.ymd);\n    return `<article class=\"card\"><div class=\"head\">\n      <div class=\"who\"><div class=\"name\"><span class=\"te\">${esc(o.f.te)}</span></div><div class=\"en\">${esc(o.f.en)}</div>\n        <div class=\"te\" style=\"font-size:.95rem;margin-top:2px\">${esc(tl.te)} · ${VAARAM[wd(o.ymd)]}</div></div>\n      <div class=\"next\"><span class=\"pill${w.n <= 14 ? ' soon' : ''}\">${w.te}</span><div class=\"en\">${w.en}</div></div></div>\n      <details class=\"more\" data-key=\"fest-${esc(o.f.id)}\"${openKeys.has('fest-' + o.f.id) ? ' open' : ''}><summary>What to do${it.mine.length ? ` · ${it.mine.length} of mine` : ''}</summary>${todoList(it)}${addBox('fest:' + o.f.id)}</details>\n      <div class=\"actions\">${reminderButtons(it)}</div></article>`;\n  }).join('');\n}\n\n// Family\nP.MASAS.forEach((m, i) => $('fMasa').insertAdjacentHTML('beforeend', `<option value=\"${i}\">${P.MASAS_TE[i]} · ${m}</option>`));\nfunction fillTithis() {\n  const k = $('fPaksha').value === 'K', sel = $('fTithi'), keep = sel.selectedIndex;\n  sel.innerHTML = '';\n  for (let i = 1; i <= 15; i++) { const t = P.tithiName(k ? i + 15 : i); sel.insertAdjacentHTML('beforeend', `<option value=\"${k ? i + 15 : i}\">${t.te} · ${t.en}</option>`); }\n  if (keep >= 0) sel.selectedIndex = keep;\n}\nfillTithis();\nconst readForm = () => ({ masa: +$('fMasa').value, tithi: +$('fTithi').value });\nfunction updatePreview() {\n  const f = readForm(), lab = tithiLabel(f.masa, f.tithi, false), next = famDates(f)[0];\n  $('preview').innerHTML = `<span class=\"te\">${esc(lab.te)}</span>${next ? ` · next: <b>${whenLabel(next.ymd).te}</b> <span class=\"en\">(${whenLabel(next.ymd).en}, ${VAARAM_EN[wd(next.ymd)]})</span>` : ''}`;\n}\n['fMasa', 'fTithi'].forEach(id => $(id).addEventListener('change', updatePreview));\n$('fPaksha').addEventListener('change', () => { fillTithis(); updatePreview(); });\n\nlet confirmId = null;\nfunction renderCards() {\n  const list = events.length ? [...events] : [EXAMPLE];\n  const rows = list.map(ev => ({ ev, all: famDates(ev) })).sort((a, b) => (a.all[0] ? dayNum(a.all[0].ymd) : 1e9) - (b.all[0] ? dayNum(b.all[0].ymd) : 1e9));\n  $('cards').innerHTML = rows.map(({ ev, all }) => {\n    const lab = tithiLabel(ev.masa, ev.tithi, false), next = all[0], w = next && whenLabel(next.ymd);\n    const yrs = all.map(o => { const sv = P.samvatsara(o.ymd, ev.masa), t = itemText(famItem(ev, o));\n      return `<span><a href=\"${gcalUrl(t.title, t.details, o.ymd)}\" target=\"_blank\" rel=\"noopener\" title=\"Add to Google Calendar\">${esc(sv.te)} · ${esc(sv.en)}</a> <span class=\"en\">${VAARAM[wd(o.ymd)]}</span></span>`; }).join('');\n    const del = ev.example ? '' : (confirmId === ev.id\n      ? `<button class=\"btn danger\" type=\"button\" data-del=\"${esc(ev.id)}\">Yes, remove</button><button class=\"btn\" type=\"button\" data-cancel=\"1\">Keep</button>`\n      : `<button class=\"btn\" type=\"button\" data-edit-ev=\"${esc(ev.id)}\">Edit</button><button class=\"btn danger\" type=\"button\" data-ask=\"${esc(ev.id)}\">Remove</button>`);\n    return `<article class=\"card${ev.example ? ' example' : ''}\">\n      <div class=\"head\">${moonSvg(ev.tithi, 38)}\n        <div class=\"who\"><div class=\"name\">${esc(ev.name)}</div>\n          <div class=\"en\">${esc(OCC[ev.occasion] || '')} · ${esc(ev.occasion)}</div>\n          <div class=\"te\" style=\"margin-top:2px\">${esc(lab.te)}</div><div class=\"en\">${esc(lab.en)}</div></div>\n        <div class=\"next\">${next ? `<span class=\"pill${w.n <= 14 ? ' soon' : ''}\">${w.te}</span><div class=\"en\">${w.en}</div><div class=\"en\">${VAARAM[wd(next.ymd)]}</div>` : ''}</div></div>\n      <div class=\"actions\">${next ? reminderButtons(famItem(ev, next)) : ''}${del}</div>\n      <details class=\"more\"><summary>Every year to ${END_YEAR} (${all.length})</summary><div class=\"years\">${yrs}</div></details>\n      ${ev.example ? '<div class=\"note\">This is an example. It goes away when you add your first person.</div>' : ''}\n    </article>`;\n  }).join('');\n  $('storeNote').textContent = store === 'db' ? 'Saved in the shared Tithi Family Notebook, so your family sees the same list, and it goes to WhatsApp.' : 'Saved in this browser only.';\n}\n\nconst openKeys = new Set();\ndocument.addEventListener('toggle', e => { const k = e.target.dataset && e.target.dataset.key; if (!k) return; e.target.open ? openKeys.add(k) : openKeys.delete(k); }, true);\n\nasync function addNote(target, text) {\n  const n = { id: 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), target, text, createdAt: new Date().toISOString() };\n  if (store === 'db') { const { id, ...body } = n; await db.collection('notes').doc(id).set(body); }\n  else { notes.push(n); saveNotes(); renderAll(); }\n}\nasync function delNote(id) {\n  if (store === 'db') await db.collection('notes').doc(id).delete();\n  else { notes = notes.filter(n => n.id !== id); saveNotes(); renderAll(); }\n}\nasync function updateNote(id, text) {\n  if (store === 'db') await db.collection('notes').doc(id).update({ text });\n  else { const n = notes.find(x => x.id === id); if (n) n.text = text; saveNotes(); }\n}\ndocument.addEventListener('click', async e => {\n  const add = e.target.closest('[data-add-note]'), del = e.target.closest('[data-del-note]');\n  const edit = e.target.closest('[data-edit-note]'), save = e.target.closest('[data-save-note]'), cancel = e.target.closest('[data-cancel-note]');\n  try {\n    if (edit) {\n      editingNote = edit.dataset.editNote; renderAll();\n      const input = [...document.querySelectorAll(`[data-save-note=\"${CSS.escape(editingNote)}\"]`)].map(b => b.closest('.addnote').querySelector('input'))[0];\n      if (input) { input.focus(); input.select(); }\n    } else if (cancel) { editingNote = null; renderAll(); }\n    else if (save) {\n      const text = save.closest('.addnote').querySelector('input').value.trim();\n      if (!text) { toast('A note can’t be empty. Use × to remove it.'); return; }\n      await updateNote(save.dataset.saveNote, text); editingNote = null; renderAll(); toast('Note updated');\n    } else if (add) {\n      const box = add.closest('.addnote'), input = box.querySelector('input'), sel = box.querySelector('select');\n      const text = input.value.trim(); if (!text) { input.focus(); return; }\n      const target = box.dataset.target === 'day' ? sel.value : box.dataset.target;\n      await addNote(target, text); toast(target.startsWith('month') ? 'Note added. It comes back every month on this tithi.'\n        : target.startsWith('year') ? 'Note added. It comes back every year on this Telugu date.'\n        : 'Note added. It comes back every time this day comes, in every year.');\n    } else if (del) { await delNote(del.dataset.delNote); toast('Note removed'); }\n  } catch (err) { toast('Could not save: ' + (err.message || err.code)); }\n});\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.closest('.addnote')) {\n    e.preventDefault(); e.target.closest('.addnote').querySelector('[data-add-note], [data-save-note]').click();\n  }\n  if (e.key === 'Escape' && editingNote) { editingNote = null; renderAll(); }\n});\n\n// My notes for any day\nconst ALL_FESTS = [...F.LIST, ...F.RECURRING, { id: 'kartikasomavaram', te: 'కార్తీక సోమవారం', en: 'Kartika Somavaram' }];\nALL_FESTS.forEach(f => $('nFest').insertAdjacentHTML('beforeend', `<option value=\"${f.id}\">${f.te} · ${f.en}</option>`));\nP.MASAS.forEach((m, i) => $('nMasa').insertAdjacentHTML('beforeend', `<option value=\"${i}\">${P.MASAS_TE[i]} · ${m}</option>`));\nfunction fillNoteTithis() {\n  const k = $('nPaksha').value === 'K', sel = $('nTithi'), keep = sel.selectedIndex;\n  sel.innerHTML = '';\n  for (let i = 1; i <= 15; i++) { const t = P.tithiName(k ? i + 15 : i); sel.insertAdjacentHTML('beforeend', `<option value=\"${k ? i + 15 : i}\">${t.te} · ${t.en}</option>`); }\n  if (keep >= 0) sel.selectedIndex = keep;\n}\nfillNoteTithis();\n$('nPaksha').addEventListener('change', fillNoteTithis);\n$('nKind').addEventListener('change', () => {\n  const k = $('nKind').value;\n  $('nFestF').hidden = k !== 'fest'; $('nMasaF').hidden = k !== 'year'; $('nDateF').hidden = k !== 'year';\n  $('nPakshaF').hidden = $('nTithiF').hidden = k === 'fest';\n});\n$('nAdd').onclick = async () => {\n  const text = $('nText').value.trim(), k = $('nKind').value;\n  $('nErr').textContent = '';\n  if (!text) { $('nErr').textContent = 'Type what to do first.'; $('nText').focus(); return; }\n  const target = k === 'fest' ? 'fest:' + $('nFest').value : k === 'year' ? `year:${$('nMasa').value}:${$('nTithi').value}` : 'month:' + $('nTithi').value;\n  try { await addNote(target, text); $('nText').value = ''; toast('Note added. It comes back on that day every year.'); }\n  catch (err) { $('nErr').textContent = 'Could not save: ' + (err.message || err.code); }\n};\n$('nText').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('nAdd').click(); } });\n\n// What a note follows, and when it next comes\nfunction targetInfo(target) {\n  const [kind, a, b] = target.split(':'), t = todayYMD(), today = dayNum(t);\n  if (kind === 'fest') {\n    const f = ALL_FESTS.find(x => x.id === a), next = festYear.find(o => o.f.id === a);\n    return { label: f ? `${f.te} · ${f.en}` : a, repeat: f && repeats(f) ? 'every time' : 'every year', next: next && next.ymd };\n  }\n  if (kind === 'fam') {\n    const ev = events.find(e => e.id === a), next = ev && famDates(ev)[0];\n    return { label: ev ? `${ev.name} – ${OCC[ev.occasion] || ev.occasion}` : 'Removed family date', repeat: 'every year', next: next && next.ymd };\n  }\n  if (kind === 'year') {\n    const next = famDates({ masa: +a, tithi: +b })[0];\n    return { label: tithiLabel(+a, +b, false).te, repeat: 'every year', next: next && next.ymd };\n  }\n  const months = P.lunarMonths(P.jdOfYMD(t) - 31, P.jdOfYMD(t) + 62);\n  const next = months.map(mi => P.tithiDay(mi.start, +a, loc()).ymd).find(d => dayNum(d) >= today);\n  return { label: `${P.tithiName(+a).te} (${P.tithiName(+a).en})`, repeat: 'every month', next };\n}\nfunction renderNotes() {\n  const groups = new Map();\n  for (const n of notes) { if (!groups.has(n.target)) groups.set(n.target, []); groups.get(n.target).push(n); }\n  const rows = [...groups].map(([target, list]) => ({ target, list, info: targetInfo(target) }))\n    .sort((x, y) => (x.info.next ? dayNum(x.info.next) : 1e9) - (y.info.next ? dayNum(y.info.next) : 1e9));\n  $('noteList').innerHTML = rows.length ? rows.map(({ list, info }) => {\n    const w = info.next && whenLabel(info.next);\n    return `<article class=\"card\"><div class=\"head\"><div class=\"who\"><div class=\"name\"><span class=\"te\">${esc(info.label)}</span></div>\n        <div class=\"en\">Comes back ${esc(info.repeat)}</div></div>\n        <div class=\"next\">${w ? `<span class=\"pill${w.n <= 14 ? ' soon' : ''}\">${w.te}</span><div class=\"en\">${w.en}</div>` : ''}</div></div>\n      <ul>${list.map(n => noteLi(n, '')).join('')}</ul></article>`;\n  }).join('') : '<p class=\"note\">No notes yet. Add one above, or tap any day in the next 30 days.</p>';\n}\n\n// Where saves go: shared with the page, or only this device. Make the device-only case impossible to miss.\nlet storeChecked = false, canWrite = null;\nconst deviceOnly = () => {\n  if (store !== 'db') return { ev: [], nt: [] };\n  const evIds = new Set(events.map(e => e.id)), ntIds = new Set(notes.map(n => n.id));\n  return { ev: loadLocal().filter(e => e && e.id && !evIds.has(e.id)), nt: loadNotes().filter(n => n && n.id && !ntIds.has(n.id)) };\n};\nfunction renderStore() {\n  const b = $('storeBanner'), txt = $('storeBannerText'), btn = $('migrateBtn');\n  btn.hidden = true; b.classList.remove('info');\n  if (store === 'local' && storeChecked) {\n    b.hidden = false;\n    txt.innerHTML = '<b>Your changes are saved only on this device.</b> Others you share the page with won’t see them, and they won’t go to WhatsApp. Check your internet connection and reload the page.';\n  } else if (store === 'db' && canWrite === false) {\n    b.hidden = false;\n    txt.innerHTML = '<b>You can view this page but not change it.</b> Ask the person who shared it to give you Contributor access in the Share menu.';\n  } else if (store === 'db') {\n    const { ev, nt } = deviceOnly(), n = ev.length + nt.length;\n    b.hidden = !n;\n    if (n) {\n      b.classList.add('info');\n      txt.innerHTML = `<b>${n} ${n === 1 ? 'entry was' : 'entries were'} saved only on this device earlier.</b> Copy ${n === 1 ? 'it' : 'them'} to the shared page so everyone sees ${n === 1 ? 'it' : 'them'} and ${n === 1 ? 'it goes' : 'they go'} to WhatsApp.`;\n      btn.textContent = `Copy ${n} to the shared page`; btn.hidden = false;\n    }\n  } else b.hidden = true;\n}\n$('migrateBtn').onclick = async () => {\n  const { ev, nt } = deviceOnly(), btn = $('migrateBtn');\n  btn.disabled = true; btn.textContent = 'Copying…';\n  let done = 0;\n  try {\n    for (const e of ev) { const { id, name, occasion, masa, tithi, createdAt } = e; await db.collection('events').doc(id).set({ name, occasion, masa, tithi, createdAt: createdAt || new Date().toISOString() }); done++; }\n    for (const n of nt) { const { id, target, text, createdAt } = n; await db.collection('notes').doc(id).set({ target, text, createdAt: createdAt || new Date().toISOString() }); done++; }\n    try { localStorage.removeItem(LS); localStorage.removeItem(NLS); } catch {}\n    toast(`Copied ${done} to the shared page`);\n  } catch (err) { toast(`Copied ${done}, then stopped: ${err.message || err.code}`); }\n  btn.disabled = false; renderStore();\n};\n\nfunction renderAll() { renderToday(); renderDays(); renderFests(); renderCards(); renderNotes(); updatePreview(); renderStore(); }\n\n$('cards').addEventListener('click', async e => {\n  const b = e.target.closest('button'); if (!b) return;\n  if (b.dataset.editEv) {\n    const ev = events.find(x => x.id === b.dataset.editEv); if (!ev) return;\n    editingEv = ev.id;\n    $('fName').value = ev.name; $('fOcc').value = ev.occasion; $('fMasa').value = String(ev.masa);\n    $('fPaksha').value = ev.tithi > 15 ? 'K' : 'S'; fillTithis(); $('fTithi').value = String(ev.tithi);\n    $('addBtn').textContent = 'Save changes'; $('cancelEditBtn').hidden = false; $('formH').textContent = `Editing ${ev.name}`;\n    updatePreview(); $('fName').scrollIntoView({ block: 'center' }); $('fName').focus();\n  }\n  else if (b.dataset.ask) { confirmId = b.dataset.ask; renderCards(); }\n  else if (b.dataset.cancel) { confirmId = null; renderCards(); }\n  else if (b.dataset.del) {\n    const id = b.dataset.del; confirmId = null;\n    if (store === 'db') { try { await db.collection('events').doc(id).delete(); } catch (err) { toast('Could not remove: ' + (err.message || err.code)); } }\n    else { events = events.filter(x => x.id !== id); saveLocal(); renderAll(); }\n  }\n});\n\nlet editingEv = null;\nfunction endEdit() {\n  editingEv = null; $('fName').value = ''; $('addBtn').textContent = 'Add'; $('cancelEditBtn').hidden = true; $('formH').textContent = 'Add a person';\n}\n$('cancelEditBtn').onclick = () => { endEdit(); $('addErr').textContent = ''; };\n$('addBtn').onclick = async () => {\n  const name = $('fName').value.trim(), f = readForm();\n  $('addErr').textContent = '';\n  if (!name) { $('addErr').textContent = 'Type a name first.'; $('fName').focus(); return; }\n  if (editingEv) {\n    const changes = { name, occasion: $('fOcc').value, masa: f.masa, tithi: f.tithi };\n    if (store === 'db') {\n      try { await db.collection('events').doc(editingEv).update(changes); } catch (err) { $('addErr').textContent = 'Could not save: ' + (err.message || err.code); return; }\n    } else { Object.assign(events.find(x => x.id === editingEv) || {}, changes); saveLocal(); renderAll(); }\n    endEdit(); toast(`Saved ${name}`); return;\n  }\n  const ev = { id: 'e' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), name, occasion: $('fOcc').value,\n    masa: f.masa, tithi: f.tithi, createdAt: new Date().toISOString() };\n  if (store === 'db') {\n    const { id, ...body } = ev;\n    try { await db.collection('events').doc(id).set(body); } catch (err) { $('addErr').textContent = 'Could not save: ' + (err.message || err.code); return; }\n  } else { events.push(ev); saveLocal(); renderAll(); }\n  $('fName').value = ''; toast(`Added ${name}`);\n};\n\nObject.entries(CITIES).forEach(([k, c]) => $('fCity').insertAdjacentHTML('beforeend', `<option value=\"${k}\">${c.name}</option>`));\n$('fCity').value = cityKey;\n$('fCity').addEventListener('change', () => {\n  cityKey = $('fCity').value; try { localStorage.setItem('tithi-city', cityKey); } catch {}\n  computeFest(); renderAll();\n});\n\nfunction toast(msg) { const t = $('toast'); t.textContent = msg; t.hidden = false; clearTimeout(toast.h); toast.h = setTimeout(() => t.hidden = true, 2800); }\n\n$('csvBtn').onclick = async () => {\n  const dl = window.claude?.use ? await claude.use('downloads') : null;\n  if (!dl) { toast('Downloads are not available here. Use the Remind me buttons instead.'); return; }\n  const btn = $('csvBtn'); btn.disabled = true; btn.textContent = 'Preparing…';\n  await new Promise(r => setTimeout(r, 30));\n  const monthly = $('incMonthly').checked, t = todayYMD();\n  const q = s => '\"' + String(s).replace(/\"/g, '\"\"') + '\"';\n  const items = F.between(t, [END_YEAR, 12, 31], loc()).filter(o => monthly || o.f.major).map(festItem);\n  for (const ev of events) for (const o of famDates(ev)) items.push(famItem(ev, o));\n  const yearTargets = [...new Set(notes.filter(n => n.target.startsWith('year:')).map(n => n.target))];\n  for (const tg of yearTargets) { const [, m, ti] = tg.split(':').map(Number);\n    for (const o of P.occurrences(m, ti, t[0], END_YEAR, loc())) if (dayNum(o.ymd) >= dayNum(t))\n      items.push({ ymd: o.ymd, masa: m, tithi: ti, title: 'నా గుర్తులు · My notes', todo: [], mine: notesFor(tg) }); }\n  const monthTithis = [...new Set(notes.filter(n => n.target.startsWith('month:')).map(n => +n.target.split(':')[1]))];\n  if (monthTithis.length) for (const mi of P.lunarMonths(P.jdOfYMD(t), P.jdOfYMD([END_YEAR, 12, 31]))) for (const ti of monthTithis) {\n    const o = P.tithiDay(mi.start, ti, loc()); if (dayNum(o.ymd) < dayNum(t) || o.ymd[0] > END_YEAR) continue;\n    items.push({ ymd: o.ymd, masa: mi.masa, tithi: ti, title: 'నా గుర్తులు · My notes', todo: [], mine: notesFor('month:' + ti) }); }\n  items.sort((a, b) => dayNum(a.ymd) - dayNum(b.ymd));\n  const lines = ['Subject,Start Date,All Day Event,Description'];\n  for (const it of items) { const x = itemText(it), [y, m, d] = it.ymd; lines.push([q(x.title), `${pad(m)}/${pad(d)}/${y}`, 'True', q(x.details)].join(',')); }\n  btn.disabled = false; btn.textContent = 'Download all reminders to 2050 for Google Calendar';\n  try { await dl.save({ filename: 'telugu-tithi-reminders.csv', data: '﻿' + lines.join('\\r\\n') }); toast(`Saved ${items.length} reminders. Import it in Google Calendar → Settings → Import.`); }\n  catch (err) { if (err.code !== 'declined') toast('Could not save the file (' + err.code + ').'); }\n};\n\n// Family dates and notes for the daily WhatsApp job (upload as data/tithi-data.json in the GitHub repo)\n$('jsonBtn').onclick = async () => {\n  const dl = window.claude?.use ? await claude.use('downloads') : null;\n  if (!dl) { toast('Downloads are not available here.'); return; }\n  const data = {\n    city: cityKey,\n    family: events.map(({ id, name, occasion, masa, tithi }) => ({ id, name, occasion, masa, tithi })),\n    notes: notes.map(({ id, target, text }) => ({ id, target, text })),\n  };\n  try { await dl.save({ filename: 'tithi-data.json', data: JSON.stringify(data, null, 2) }); toast('Saved. Upload it to the data folder of your GitHub repo.'); }\n  catch (err) { if (err.code !== 'declined') toast('Could not save the file (' + err.code + ').'); }\n};\n\nfunction teluguOf(v) { const [y, m, d] = v.split('-').map(Number); return P.dayInfo(y, m, d, loc()); }\n$('fDate').addEventListener('change', () => {\n  if (!$('fDate').value) return;\n  const i = teluguOf($('fDate').value);\n  $('fMasa').value = String(i.masa); $('fPaksha').value = i.tithi > 15 ? 'K' : 'S'; fillTithis(); $('fTithi').value = String(i.tithi);\n  updatePreview(); toast('Telugu date: ' + tithiLabel(i.masa, i.tithi, false).te);\n});\n$('nDate').addEventListener('change', () => {\n  if (!$('nDate').value) return;\n  const i = teluguOf($('nDate').value);\n  $('nMasa').value = String(i.masa); $('nPaksha').value = i.tithi > 15 ? 'K' : 'S'; fillNoteTithis(); $('nTithi').value = String(i.tithi);\n  toast('Telugu date: ' + tithiLabel(i.masa, i.tithi, false).te + ' (every year)');\n});\n\ncomputeFest();\nrenderAll();\n\n(async () => {\n  const d = window.claude?.use ? await claude.use('db') : null;\n  storeChecked = true;\n  if (!d) { renderStore(); return; }\n  db = d;\n  (async () => {\n    const u = window.claude?.use ? await claude.use('user') : null;\n    canWrite = u ? await u.can('data.write') : null;\n    renderStore();\n  })();\n  db.collection('events').onSnapshot(snap => {\n    store = 'db';\n    events = snap.docs.map(s => ({ id: s.id, ...s.data() })).filter(e => Number.isInteger(e.masa) && Number.isInteger(e.tithi));\n    renderAll();\n  }, () => { store = 'local'; storeChecked = true; events = loadLocal(); renderAll(); });\n  db.collection('notes').onSnapshot(snap => {\n    notes = snap.docs.map(s => ({ id: s.id, ...s.data() })).filter(n => typeof n.target === 'string' && typeof n.text === 'string');\n    renderAll();\n  }, () => { notes = loadNotes(); renderAll(); });\n})();\n})();\n</script>\n";
