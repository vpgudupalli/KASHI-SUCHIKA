 border-radius: 8px; background: var(--bg); }\nbutton.primary, a.btn, button.btn { font: inherit; font-size: .85rem; font-weight: 600; border-radius: 8px; padding: 8px 12px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }\nbutton.primary { background: var(--accent); color: var(--accent-ink); border: 0; }\na.btn, button.btn { background: transparent; color: var(--ink); border: 1px solid var(--line); }\nbutton.btn.danger { color: var(--warn); }\n.actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n\n/* Day list */\n.days { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\n.day { border-top: 1px solid var(--line); }\n.day:first-child { border-top: 0; }\n.day > summary, .day > .plain { list-style: none; display: grid; grid-template-columns: 26px 92px 1fr; gap: 10px; align-items: center; padding: 10px 14px; }\n.day > summary { cursor: pointer; }\n.day > summary::-webkit-details-marker { display: none; }\n.when { font-size: .8rem; font-weight: 600; line-height: 1.25; }\n.when .vaar { display: block; font-weight: 400; color: var(--muted); }\n.what { min-width: 0; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; }\n.what .t { font-family: var(--display); }\n.chip { font-size: .78rem; font-weight: 600; padding: 2px 8px; border-radius: 99px; background: var(--chip); color: var(--chip-ink); }\n.chip.major { background: var(--accent); color: var(--accent-ink); }\n.chip.fam { background: var(--night); color: var(--night-ink); }\n.dbody { padding: 0 14px 14px 52px; display: flex; flex-direction: column; gap: 12px; }\n.dbody h4 { margin: 0; font-weight: 600; font-size: .95rem; }\n.dbody ul { margin: 4px 0 6px; padding-left: 18px; }\nli.mine { color: var(--ink); }\nli.mine::marker { color: var(--accent); }\n.mine-tag { font-size: .7rem; font-weight: 600; color: var(--accent); margin-left: 4px; }\nbutton.x { border: 0; background: transparent; color: var(--muted); cursor: pointer; font: inherit; padding: 0 6px; }\nbutton.x:hover { color: var(--warn); }\n.addnote { display: flex; gap: 6px; flex-wrap: wrap; }\n.addnote input { flex: 1 1 180px; min-width: 0; padding: 7px 9px; }\n.addnote select { flex: 0 1 auto; width: auto; max-width: 100%; padding: 7px 9px; }\n.today li.mine { color: var(--night-ink); }\n.day.today-row { background: var(--chip); }\n\n/* Festivals & family */\n.list { display: flex; flex-direction: column; gap: 10px; }\n.card { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }\n.card.example { border-style: dashed; }\n.head { display: flex; gap: 12px; align-items: flex-start; }\n.head .who { flex: 1; min-width: 0; }\n.name { font-weight: 600; font-size: 1.02rem; }\n.name .te { font-size: 1.12rem; font-weight: 400; }\n.next { text-align: right; flex-shrink: 0; }\n.pill { display: inline-block; font-size: .75rem; font-weight: 600; padding: 2px 8px; border-radius: 99px; background: var(--bg); color: var(--muted); }\n.pill.soon { background: var(--accent); color: var(--accent-ink); }\ndetails.more summary { cursor: pointer; font-size: .85rem; color: var(--muted); }\n.card ul { margin: 6px 0 0; padding-left: 18px; }\n.years { margin-top: 8px; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 6px 12px; font-size: .86rem; }\n.years a { color: var(--ink); text-decoration: none; border-bottom: 1px dotted var(--line); }\n.note { font-size: .85rem; color: var(--muted); }\n.note p { margin: 0 0 8px; }\n.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); background: var(--ink); color: var(--paper); padding: 10px 16px; border-radius: 10px; font-size: .9rem; max-width: calc(100% - 48px); }\n.err { color: var(--warn); font-size: .85rem; }\n.banner { border: 2px solid var(--warn); background: var(--paper); color: var(--ink); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; font-size: .92rem; }\n.banner b { color: var(--warn); }\n.banner.info { border-color: var(--accent); }\n.banner.info b { color: var(--ink); }\n@media (max-width: 440px) { .day > summary, .day > .plain { grid-template-columns: 22px 78px 1fr; gap: 8px; padding: 10px 12px; } .dbody { padding-left: 14px; } }\n</style>\n\n<div class=\"wrap\">\n  <div class=\"banner\" id=\"storeBanner\" role=\"status\" hidden>\n    <div id=\"storeBannerText\"></div>\n    <div class=\"actions\"><button class=\"primary\" type=\"button\" id=\"migrateBtn\" hidden></button></div>\n  </div>\n  <header>\n    <h1>తిథి గుర్తులు · Tithi Reminders</h1>\n    <p class=\"lede\">The Telugu calendar for every day: today's tithi, festivals with what to do on each, your family's birthdays and anniversaries by tithi, and your own notes on any day. Tap a day to add yours.</p>\n  </header>\n\n  <section class=\"today\" aria-label=\"Today\">\n    <div class=\"top\">\n      <div id=\"todayMoon\"></div>\n      <div>\n        <div class=\"lbl\">ఈరోజు · Today · <span id=\"todayCity\"></span></div>\n        <div class=\"big\" id=\"todayTe\"></div>\n        <div class=\"small\" id=\"todayEn\"></div>\n      </div>\n    </div>\n    <div class=\"fest\" id=\"todayFest\" hidden></div>\n  </section>\n\n  <section class=\"section\" aria-labelledby=\"daysH\">\n    <h2 id=\"daysH\">రాబోయే 30 రోజులు <small>Next 30 days</small></h2>\n    <div class=\"days\" id=\"days\"></div>\n  </section>\n\n  <section class=\"section\" aria-labelledby=\"festH\">\n    <h2 id=\"festH\">పండుగలు <small>Festivals in the coming year</small></h2>\n    <div class=\"list\" id=\"fests\"></div>\n  </section>\n\n  <section class=\"section\" aria-labelledby=\"famH\">\n    <h2 id=\"famH\">కుటుంబ తిథులు <small>Family birthdays and anniversaries</small></h2>\n    <div class=\"panel\">\n      <div class=\"name\" id=\"formH\">Add a person</div>\n      <div class=\"row\">\n        <div class=\"field\"><label for=\"fName\">Name</label><input id=\"fName\" placeholder=\"e.g. Amma\" autocomplete=\"off\"></div>\n        <div class=\"field\"><label for=\"fOcc\">Occasion</label>\n          <select id=\"fOcc\">\n            <option value=\"Birthday\">పుట్టినరోజు · Birthday</option>\n            <option value=\"Wedding anniversary\">పెళ్లిరోజు · Wedding anniversary</option>\n            <option value=\"Aabdikam\">ఆబ్దికం · Aabdikam</option>\n            <option value=\"Other\">ఇతర · Other</option>\n          </select></div>\n      </div>\n      <div class=\"row\">\n        <div class=\"field\"><label for=\"fMasa\">మాసం · Masam</label><select id=\"fMasa\"></select></div>\n        <div class=\"field\"><label for=\"fPaksha\">పక్షం · Paksham</label>\n          <select id=\"fPaksha\"><option value=\"S\">శుక్ల పక్షం · Shukla</option><option value=\"K\">కృష్ణ పక్షం · Krishna (Bahula)</option></select></div>\n        <div class=\"field\"><label for=\"fTithi\">తిథి · Tithi</label><select id=\"fTithi\"></select></div>\n      </div>\n      <div class=\"field\"><label for=\"fDate\">📅 Or pick the date on the calendar (birth / wedding / passing)</label><input id=\"fDate\" type=\"date\" min=\"1900-01-01\" max=\"2100-12-31\"></div>\n      <div class=\"preview\" id=\"preview\" aria-live=\"polite\"></div>\n      <div class=\"actions\"><button class=\"primary\" id=\"addBtn\" type=\"button\">Add</button><button class=\"btn\" id=\"cancelEditBtn\" type=\"button\" hidden>Cancel</button><span class=\"err\" id=\"addErr\"></span></div>\n    </div>\n    <div class=\"list\" id=\"cards\"></div>\n    <p class=\"note\" id=\"storeNote\"></p>\n  </section>\n\n  <section class=\"section\" aria-labelledby=\"notesH\">\n    <h2 id=\"notesH\">నా గుర్తులు <small>My notes for any day</small></h2>\n    <div class=\"panel\">\n      <p class=\"note\" style=\"margin:0\">Each note stays with its Telugu day, so it comes back on that day every year through 2050, even though